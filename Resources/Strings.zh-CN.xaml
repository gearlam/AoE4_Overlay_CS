<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <sys:String x:Key="Menu_File" xmlns:sys="clr-namespace:System;assembly=System.Runtime">文件</sys:String>
    <sys:String x:Key="Menu_File_HtmlFiles" xmlns:sys="clr-namespace:System;assembly=System.Runtime">Html 文件</sys:String>
    <sys:String x:Key="Menu_File_ConfigLogs" xmlns:sys="clr-namespace:System;assembly=System.Runtime">配置/日志</sys:String>
    <sys:String x:Key="Menu_File_Exit" xmlns:sys="clr-namespace:System;assembly=System.Runtime">退出</sys:String>

    <sys:String x:Key="Menu_Settings" xmlns:sys="clr-namespace:System;assembly=System.Runtime">设置</sys:String>
    <sys:String x:Key="Menu_Settings_LogMatches" xmlns:sys="clr-namespace:System;assembly=System.Runtime">记录比赛数据</sys:String>

    <sys:String x:Key="Menu_Links" xmlns:sys="clr-namespace:System;assembly=System.Runtime">链接</sys:String>
    <sys:String x:Key="Menu_Links_Github" xmlns:sys="clr-namespace:System;assembly=System.Runtime">GitHub 项目</sys:String>

    <sys:String x:Key="Menu_Language" xmlns:sys="clr-namespace:System;assembly=System.Runtime">语言</sys:String>
    <sys:String x:Key="Menu_Language_English" xmlns:sys="clr-namespace:System;assembly=System.Runtime">English</sys:String>
    <sys:String x:Key="Menu_Language_Chinese" xmlns:sys="clr-namespace:System;assembly=System.Runtime">中文</sys:String>

    <sys:String x:Key="Tab_Settings" xmlns:sys="clr-namespace:System;assembly=System.Runtime">设置</sys:String>
    <sys:String x:Key="Tab_Games" xmlns:sys="clr-namespace:System;assembly=System.Runtime">对战</sys:String>

    <sys:String x:Key="Settings_GameLabel" xmlns:sys="clr-namespace:System;assembly=System.Runtime">轮询游戏：</sys:String>
    <sys:String x:Key="Settings_ProfileHeader" xmlns:sys="clr-namespace:System;assembly=System.Runtime">档案</sys:String>
    <sys:String x:Key="Settings_ProfileLinkText" xmlns:sys="clr-namespace:System;assembly=System.Runtime">AoE4World 档案页</sys:String>
    <sys:String x:Key="Settings_SearchPlaceholder" xmlns:sys="clr-namespace:System;assembly=System.Runtime">Steam ID / Profile ID / 名字</sys:String>
    <sys:String x:Key="Settings_SearchButton" xmlns:sys="clr-namespace:System;assembly=System.Runtime">搜索</sys:String>

    <sys:String x:Key="Settings_OverlayHeader" xmlns:sys="clr-namespace:System;assembly=System.Runtime">覆盖层</sys:String>
    <sys:String x:Key="Settings_HotkeyLabel" xmlns:sys="clr-namespace:System;assembly=System.Runtime">热键：</sys:String>
    <sys:String x:Key="Settings_PositionHotkeyLabel" xmlns:sys="clr-namespace:System;assembly=System.Runtime">位置热键：</sys:String>
    <sys:String x:Key="Settings_FontSizeLabel" xmlns:sys="clr-namespace:System;assembly=System.Runtime">覆盖层字体大小：</sys:String>
    <sys:String x:Key="Settings_TeamGapLabel" xmlns:sys="clr-namespace:System;assembly=System.Runtime">队伍间隔：</sys:String>
    <sys:String x:Key="Settings_BackgroundColorLabel" xmlns:sys="clr-namespace:System;assembly=System.Runtime">覆盖层背景色：</sys:String>
    <sys:String x:Key="Settings_BackgroundOpacityLabel" xmlns:sys="clr-namespace:System;assembly=System.Runtime">背景不透明度：</sys:String>

    <sys:String x:Key="Settings_MacroHeader" xmlns:sys="clr-namespace:System;assembly=System.Runtime">热键自动化</sys:String>
    <sys:String x:Key="Settings_MacroEnableLabel" xmlns:sys="clr-namespace:System;assembly=System.Runtime">启用热键自动化：</sys:String>
    <sys:String x:Key="Settings_MacroEnableHint" xmlns:sys="clr-namespace:System;assembly=System.Runtime">按触发热键开始/停止执行；最小化到托盘时持续运行，退出程序时自动停止</sys:String>
    <sys:String x:Key="Settings_MacroTriggerLabel" xmlns:sys="clr-namespace:System;assembly=System.Runtime">触发热键：</sys:String>
    <sys:String x:Key="Settings_MacroSequenceLabel" xmlns:sys="clr-namespace:System;assembly=System.Runtime">热键序列：</sys:String>
    <sys:String x:Key="Settings_MacroSequenceHint" xmlns:sys="clr-namespace:System;assembly=System.Runtime">手动输入格式：H+Q+Q+Q，支持 Ctrl+A 与数字键（控制组编队）；点“录制”后依次按键追加，Esc 结束，Backspace 删除末位。减少干扰建议用编队选基地并回切部队，如 4+Q+1</sys:String>
    <sys:String x:Key="Settings_MacroRecordButton" xmlns:sys="clr-namespace:System;assembly=System.Runtime">录制</sys:String>
    <sys:String x:Key="Settings_MacroClearButton" xmlns:sys="clr-namespace:System;assembly=System.Runtime">清空</sys:String>
    <sys:String x:Key="Settings_MacroIntervalLabel" xmlns:sys="clr-namespace:System;assembly=System.Runtime">触发间隔（秒）：</sys:String>
    <sys:String x:Key="Settings_MacroIdleLabel" xmlns:sys="clr-namespace:System;assembly=System.Runtime">操作避让（毫秒）：</sys:String>
    <sys:String x:Key="Settings_MacroIdleHint" xmlns:sys="clr-namespace:System;assembly=System.Runtime">检测到键鼠操作时推迟发送，空闲后才注入；0 = 不避让</sys:String>
    <sys:String x:Key="Settings_MacroShiftLabel" xmlns:sys="clr-namespace:System;assembly=System.Runtime">监控 Shift：</sys:String>
    <sys:String x:Key="Settings_MacroShiftHint" xmlns:sys="clr-namespace:System;assembly=System.Runtime">勾选后，无限循环只在间隔结束前 1 秒检测 Shift；仍按住则等待，松开后立即发送组合键</sys:String>
    <sys:String x:Key="Settings_MacroRepeatLabel" xmlns:sys="clr-namespace:System;assembly=System.Runtime">重复次数：</sys:String>
    <sys:String x:Key="Settings_MacroInfiniteLabel" xmlns:sys="clr-namespace:System;assembly=System.Runtime">无限循环</sys:String>
    <sys:String x:Key="Settings_MacroTestButton" xmlns:sys="clr-namespace:System;assembly=System.Runtime">测试</sys:String>
    <sys:String x:Key="Settings_MacroStatusLabel" xmlns:sys="clr-namespace:System;assembly=System.Runtime">运行状态：</sys:String>

    <sys:String x:Key="Games_Header_Team1" xmlns:sys="clr-namespace:System;assembly=System.Runtime">队伍 1</sys:String>
    <sys:String x:Key="Games_Header_Team2" xmlns:sys="clr-namespace:System;assembly=System.Runtime">队伍 2</sys:String>
    <sys:String x:Key="Games_Header_Map" xmlns:sys="clr-namespace:System;assembly=System.Runtime">地图</sys:String>
    <sys:String x:Key="Games_Header_Started" xmlns:sys="clr-namespace:System;assembly=System.Runtime">开始时间</sys:String>
    <sys:String x:Key="Games_Header_Mode" xmlns:sys="clr-namespace:System;assembly=System.Runtime">模式</sys:String>
    <sys:String x:Key="Games_Header_Result" xmlns:sys="clr-namespace:System;assembly=System.Runtime">结果</sys:String>
    <sys:String x:Key="Games_Header_Diff" xmlns:sys="clr-namespace:System;assembly=System.Runtime">分差</sys:String>
    <sys:String x:Key="Games_Header_Match" xmlns:sys="clr-namespace:System;assembly=System.Runtime">对战</sys:String>

    <sys:String x:Key="Tr_Settings" xmlns:sys="clr-namespace:System;assembly=System.Runtime">游戏聊天翻译设置</sys:String>
    <sys:String x:Key="Tr_Title" xmlns:sys="clr-namespace:System;assembly=System.Runtime">帝国即时翻译</sys:String>
    <sys:String x:Key="Tr_Privacy" xmlns:sys="clr-namespace:System;assembly=System.Runtime">文本会发送到你配置的第三方服务。API Key 使用 Windows 当前用户加密；原文与译文以明文保存在本机。测试会实际调用模型，可能产生费用。远程接口必须使用 HTTPS。</sys:String>
    <sys:String x:Key="Tr_Endpoint" xmlns:sys="clr-namespace:System;assembly=System.Runtime">API 地址（包含 /v1，或完整 /chat/completions 地址）</sys:String>
    <sys:String x:Key="Tr_Key" xmlns:sys="clr-namespace:System;assembly=System.Runtime">API Key（本地免鉴权模型可留空）</sys:String>
    <sys:String x:Key="Tr_Model" xmlns:sys="clr-namespace:System;assembly=System.Runtime">模型名称</sys:String>
    <sys:String x:Key="Tr_Enable" xmlns:sys="clr-namespace:System;assembly=System.Runtime">启用全局翻译快捷键</sys:String>
    <sys:String x:Key="Tr_Hotkey" xmlns:sys="clr-namespace:System;assembly=System.Runtime">快捷键（设置期间暂停触发，保存并关闭设置后生效，如 F9）</sys:String>
    <sys:String x:Key="Tr_Source" xmlns:sys="clr-namespace:System;assembly=System.Runtime">源语言（Chinese=中文 / English=英文 / Spanish=西班牙语）</sys:String>
    <sys:String x:Key="Tr_Target" xmlns:sys="clr-namespace:System;assembly=System.Runtime">目标语言</sys:String>
    <sys:String x:Key="Tr_Network" xmlns:sys="clr-namespace:System;assembly=System.Runtime">网络模式：Direct=直连（默认）；System=系统代理；Custom=自定义代理。请与 Cherry Studio 的代理设置保持一致。</sys:String>
    <sys:String x:Key="Tr_ProxyUrl" xmlns:sys="clr-namespace:System;assembly=System.Runtime">自定义代理地址（仅 Custom 使用，如 http://127.0.0.1:7890）</sys:String>
    <sys:String x:Key="Tr_TimeoutLabel" xmlns:sys="clr-namespace:System;assembly=System.Runtime">请求总超时（10–300 秒，默认 90；连接超时 15 秒）</sys:String>
    <sys:String x:Key="Tr_Timeout" xmlns:sys="clr-namespace:System;assembly=System.Runtime">请求超时，请检查网络/代理，慢模型可增大超时：</sys:String>
    <sys:String x:Key="Tr_HistoryFolder" xmlns:sys="clr-namespace:System;assembly=System.Runtime">打开历史文件夹</sys:String>
    <sys:String x:Key="Tr_Test" xmlns:sys="clr-namespace:System;assembly=System.Runtime">测试模型</sys:String>
    <sys:String x:Key="Tr_Save" xmlns:sys="clr-namespace:System;assembly=System.Runtime">保存并应用</sys:String>
    <sys:String x:Key="Tr_Open" xmlns:sys="clr-namespace:System;assembly=System.Runtime">打开翻译窗口</sys:String>
    <sys:String x:Key="Tr_WindowHint" xmlns:sys="clr-namespace:System;assembly=System.Runtime">Enter 翻译；Shift+Enter 换行；Esc 或快捷键关闭。译文手动复制到游戏，不自动发送。建议使用无边框/窗口化游戏；独占全屏可能遮挡桌面窗口。语言与接口编辑即时用于下一次请求，保存后重启保留。</sys:String>
    <sys:String x:Key="Tr_Translate" xmlns:sys="clr-namespace:System;assembly=System.Runtime">翻译（Enter）</sys:String>
    <sys:String x:Key="Tr_Copy" xmlns:sys="clr-namespace:System;assembly=System.Runtime">复制译文</sys:String>
    <sys:String x:Key="Tr_ClearInput" xmlns:sys="clr-namespace:System;assembly=System.Runtime">清空输入</sys:String>
    <sys:String x:Key="Tr_Clear" xmlns:sys="clr-namespace:System;assembly=System.Runtime">清空全部</sys:String>
    <sys:String x:Key="Tr_Delete" xmlns:sys="clr-namespace:System;assembly=System.Runtime">删除本条</sys:String>
    <sys:String x:Key="Tr_History" xmlns:sys="clr-namespace:System;assembly=System.Runtime">本地翻译历史（可选中文字复制）</sys:String>
    <sys:String x:Key="Tr_ClearConfirm" xmlns:sys="clr-namespace:System;assembly=System.Runtime">确定永久清空全部本地翻译历史？此操作不可撤销。</sys:String>
    <sys:String x:Key="Tr_Saved" xmlns:sys="clr-namespace:System;assembly=System.Runtime">已保存。关闭设置窗口后启用快捷键。</sys:String>
    <sys:String x:Key="Tr_Working" xmlns:sys="clr-namespace:System;assembly=System.Runtime">正在请求模型…</sys:String>
    <sys:String x:Key="Tr_TestOk" xmlns:sys="clr-namespace:System;assembly=System.Runtime">模型可用，测试译文：</sys:String>
    <sys:String x:Key="Tr_Done" xmlns:sys="clr-namespace:System;assembly=System.Runtime">翻译完成，已保存到本地历史。</sys:String>
    <sys:String x:Key="Tr_Cancelled" xmlns:sys="clr-namespace:System;assembly=System.Runtime">请求已取消。</sys:String>
    <sys:String x:Key="Tr_Copied" xmlns:sys="clr-namespace:System;assembly=System.Runtime">已复制，请切回游戏粘贴。</sys:String>
    <sys:String x:Key="Tr_Error" xmlns:sys="clr-namespace:System;assembly=System.Runtime">操作失败：</sys:String>
    <sys:String x:Key="Tr_StorageError" xmlns:sys="clr-namespace:System;assembly=System.Runtime">本地存储失败，请检查翻译数据文件及目录权限：</sys:String>
    <sys:String x:Key="Tr_InvalidHotkey" xmlns:sys="clr-namespace:System;assembly=System.Runtime">快捷键无效。请使用 F1–F24 或带 Ctrl/Alt/Shift 的组合键。</sys:String>
    <sys:String x:Key="Tr_Conflict" xmlns:sys="clr-namespace:System;assembly=System.Runtime">翻译快捷键与覆盖层或宏快捷键冲突，未注册。请修改后保存。</sys:String>
    <sys:String x:Key="Tr_HotkeyFailed" xmlns:sys="clr-namespace:System;assembly=System.Runtime">无法注册翻译快捷键，请尝试其他组合。</sys:String>
</ResourceDictionary>
