<UserControl x:Class="AoE4OverlayCS.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="18" FontWeight="SemiBold" Foreground="#222"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Profile Box -->
            <GroupBox Header="{DynamicResource Settings_ProfileHeader}" Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="{Binding ProfileInfo}" 
                               FontSize="16" FontWeight="Bold" Foreground="#359c20" 
                               TextWrapping="Wrap" Margin="0,0,0,5"/>
                    
                    <TextBlock Margin="0,0,0,10">
                        <Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="{Binding ProfileLink}">
                            <TextBlock Text="{DynamicResource Settings_ProfileLinkText}" FontSize="16"/>
                        </Hyperlink>
                    </TextBlock>
                    
                    <TextBlock Text="{Binding SearchStatusText}" Foreground="{Binding SearchStatusBrush}"
                               FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                    
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SearchHistoryComboBox"
                                  Grid.Column="0" Margin="0,0,10,0"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  StaysOpenOnEdit="True"
                                  ItemsSource="{Binding SearchHistory}"
                                  Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                  KeyDown="SearchTextBox_KeyDown"
                                  PreviewMouseLeftButtonDown="SearchHistoryComboBox_PreviewMouseLeftButtonDown"
                                  Tag="{DynamicResource Settings_SearchPlaceholder}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="6,0,8,0"/>
                                        <Button Grid.Column="1"
                                                Content="删除"
                                                Padding="8,2"
                                                Height="26"
                                                Margin="0,0,6,0"
                                                Tag="{Binding}"
                                                Click="DeleteSearchHistory_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Content="{DynamicResource Settings_SearchButton}" Command="{Binding SearchPlayerCommand}" Grid.Column="1"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- Overlay Box -->
            <GroupBox Header="{DynamicResource Settings_OverlayHeader}" Grid.Row="1">
                <StackPanel>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Settings_HotkeyLabel}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="HotkeyButton" Content="{Binding Settings.OverlayHotkey, TargetNullValue='Click to set'}" 
                                Grid.Column="1" HorizontalAlignment="Left" Width="180" Height="34"
                                Click="HotkeyButton_Click" PreviewKeyDown="HotkeyButton_PreviewKeyDown"/>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Settings_PositionHotkeyLabel}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="PositionHotkeyButton" Content="{Binding Settings.OverlayPositionHotkey, TargetNullValue='Click to set'}" 
                                Grid.Column="1" HorizontalAlignment="Left" Width="180" Height="34"
                                Click="PositionHotkeyButton_Click" PreviewKeyDown="PositionHotkeyButton_PreviewKeyDown"/>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Settings_FontSizeLabel}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox SelectedItem="{Binding Settings.FontSize}" Grid.Column="1" HorizontalAlignment="Left" Width="180" Height="34" FontSize="15" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                             <system:Int32 xmlns:system="clr-namespace:System;assembly=System.Runtime">10</system:Int32>
                             <system:Int32 xmlns:system="clr-namespace:System;assembly=System.Runtime">11</system:Int32>
                             <system:Int32 xmlns:system="clr-namespace:System;assembly=System.Runtime">12</system:Int32>
                             <system:Int32 xmlns:system="clr-namespace:System;assembly=System.Runtime">13</system:Int32>
                             <system:Int32 xmlns:system="clr-namespace:System;assembly=System.Runtime">14</system:Int32>
                             <system:Int32 xmlns:system="clr-namespace:System;assembly=System.Runtime">16</system:Int32>
                             <system:Int32 xmlns:system="clr-namespace:System;assembly=System.Runtime">18</system:Int32>
                             <system:Int32 xmlns:system="clr-namespace:System;assembly=System.Runtime">20</system:Int32>
                             <system:Int32 xmlns:system="clr-namespace:System;assembly=System.Runtime">22</system:Int32>
                             <system:Int32 xmlns:system="clr-namespace:System;assembly=System.Runtime">24</system:Int32>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Settings_TeamGapLabel}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider Value="{Binding Settings.TeamGap}" Minimum="0" Maximum="80" Width="180" Height="34" TickFrequency="4" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding Settings.TeamGap, StringFormat={}{0:0}}" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center" Width="40"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </GroupBox>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
