<UserControl x:Class="AoE4OverlayCS.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d" 
             PreviewKeyDown="SettingsView_PreviewKeyDown"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="18" FontWeight="SemiBold" Foreground="#222"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Profile Box -->
            <GroupBox Header="{DynamicResource Settings_ProfileHeader}" Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="{Binding ProfileInfo}" 
                               FontSize="16" FontWeight="Bold" Foreground="#359c20" 
                               TextWrapping="Wrap" Margin="0,0,0,5"/>

                    <TextBlock Text="{Binding ProfileRankInfo}" 
                               FontSize="15" FontWeight="SemiBold" Foreground="#444" 
                               TextWrapping="Wrap" Margin="0,0,0,5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="{x:Static sys:String.Empty}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    
                    <TextBlock Margin="0,0,0,10">
                        <Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="{Binding ProfileLink}">
                            <TextBlock Text="{DynamicResource Settings_ProfileLinkText}" FontSize="16"/>
                        </Hyperlink>
                    </TextBlock>
                    
                    <TextBlock Text="{Binding SearchStatusText}" Foreground="{Binding SearchStatusBrush}"
                               FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                    
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SearchHistoryComboBox"
                                  Grid.Column="0" Margin="0,0,10,0"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  StaysOpenOnEdit="True"
                                  ItemsSource="{Binding SearchHistory}"
                                  Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                  KeyDown="SearchTextBox_KeyDown"
                                  PreviewMouseLeftButtonDown="SearchHistoryComboBox_PreviewMouseLeftButtonDown"
                                  Tag="{DynamicResource Settings_SearchPlaceholder}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="6,0,8,0"/>
                                        <Button Grid.Column="1"
                                                Content="删除"
                                                Padding="8,2"
                                                Height="26"
                                                Margin="0,0,6,0"
                                                Tag="{Binding}"
                                                Click="DeleteSearchHistory_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Content="{DynamicResource Settings_SearchButton}" Command="{Binding SearchPlayerCommand}" Grid.Column="1"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- Overlay Box -->
            <GroupBox Header="{DynamicResource Settings_OverlayHeader}" Grid.Row="1">
                <StackPanel>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Settings_HotkeyLabel}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="HotkeyButton" Content="{Binding Settings.OverlayHotkey, TargetNullValue='Click to set'}" 
                                Grid.Column="1" HorizontalAlignment="Left" Width="180" Height="34"
                                Click="HotkeyButton_Click" PreviewKeyDown="HotkeyButton_PreviewKeyDown"/>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Settings_PositionHotkeyLabel}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="PositionHotkeyButton" Content="{Binding Settings.OverlayPositionHotkey, TargetNullValue='Click to set'}" 
                                Grid.Column="1" HorizontalAlignment="Left" Width="180" Height="34"
                                Click="PositionHotkeyButton_Click" PreviewKeyDown="PositionHotkeyButton_PreviewKeyDown"/>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Settings_FontSizeLabel}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox SelectedItem="{Binding Settings.FontSize}" Grid.Column="1" HorizontalAlignment="Left" Width="180" Height="34" FontSize="15" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                             <system:Int32 xmlns:system="clr-namespace:System;assembly=System.Runtime">10</system:Int32>
                             <system:Int32 xmlns:system="clr-namespace:System;assembly=System.Runtime">11</system:Int32>
                             <system:Int32 xmlns:system="clr-namespace:System;assembly=System.Runtime">12</system:Int32>
                             <system:Int32 xmlns:system="clr-namespace:System;assembly=System.Runtime">13</system:Int32>
                             <system:Int32 xmlns:system="clr-namespace:System;assembly=System.Runtime">14</system:Int32>
                             <system:Int32 xmlns:system="clr-namespace:System;assembly=System.Runtime">16</system:Int32>
                             <system:Int32 xmlns:system="clr-namespace:System;assembly=System.Runtime">18</system:Int32>
                             <system:Int32 xmlns:system="clr-namespace:System;assembly=System.Runtime">20</system:Int32>
                             <system:Int32 xmlns:system="clr-namespace:System;assembly=System.Runtime">22</system:Int32>
                             <system:Int32 xmlns:system="clr-namespace:System;assembly=System.Runtime">24</system:Int32>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Settings_TeamGapLabel}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider Value="{Binding Settings.TeamGap}" Minimum="0" Maximum="80" Width="180" Height="34" TickFrequency="4" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding Settings.TeamGap, StringFormat={}{0:0}}" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center" Width="40"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Settings_BackgroundColorLabel}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BackgroundColorButton" Width="150" Height="34" Click="BackgroundColorButton_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="BackgroundColorSwatch" Width="18" Height="18" CornerRadius="3" BorderBrush="#999" BorderThickness="1"/>
                                    <TextBlock x:Name="BackgroundColorText" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{DynamicResource Settings_BackgroundOpacityLabel}" FontSize="16" VerticalAlignment="Center" Margin="20,0,10,0"/>
                            <Slider Value="{Binding Settings.OverlayBackgroundOpacity}" Minimum="0" Maximum="1" Width="120" Height="34" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding Settings.OverlayBackgroundOpacity, StringFormat={}{0:P0}}" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="46"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- Macro Automation Panel（点击标题展开热键自动化设置面板） -->
            <Expander Grid.Row="2" IsExpanded="False" Margin="0,0,0,18">
                <Expander.Header>
                    <TextBlock Text="{DynamicResource Settings_MacroHeader}" FontSize="18" FontWeight="SemiBold" Foreground="#222"/>
                </Expander.Header>
                <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="16" Margin="0,8,0,0">
                    <StackPanel>
                        <!-- 启用开关 -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_MacroEnableLabel}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <CheckBox x:Name="MacroEnabledCheckBox" IsChecked="{Binding Settings.MacroEnabled}" FontSize="15" HorizontalAlignment="Left"
                                          Checked="MacroEnabledCheckBox_Changed" Unchecked="MacroEnabledCheckBox_Changed"/>
                                <TextBlock Text="{DynamicResource Settings_MacroEnableHint}" FontSize="12" Foreground="#888" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- 触发热键 -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_MacroTriggerLabel}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button x:Name="MacroTriggerHotkeyButton" Content="{Binding Settings.MacroTriggerHotkey, TargetNullValue='Click to set'}"
                                    Grid.Column="1" HorizontalAlignment="Left" Width="180" Height="34"
                                    Click="MacroTriggerHotkeyButton_Click" PreviewKeyDown="MacroTriggerHotkeyButton_PreviewKeyDown"/>
                        </Grid>

                        <!-- 热键序列（手动输入 + 录制 + 按键芯片可视化） -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_MacroSequenceLabel}" FontSize="16" VerticalAlignment="Top" Margin="0,7,10,0"/>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="MacroSequenceTextBox" Width="240" MaxLength="400"
                                             Text="{Binding Settings.MacroSequence, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                                    <Button x:Name="MacroRecordButton" Content="{DynamicResource Settings_MacroRecordButton}" Margin="10,0,0,0" Click="MacroRecordButton_Click"/>
                                    <Button Content="{DynamicResource Settings_MacroClearButton}" Margin="10,0,0,0" Click="MacroClearButton_Click"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding MacroKeyChips}" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F7F7F7" BorderBrush="#C5C5C5" BorderThickness="1" CornerRadius="4" Padding="9,4" Margin="0,0,6,6">
                                                <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" Foreground="#333"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{DynamicResource Settings_MacroSequenceHint}" FontSize="12" Foreground="#888" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- 触发间隔（秒） -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_MacroIntervalLabel}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="MacroIntervalTextBox" Width="60" TextAlignment="Center"
                                         Text="{Binding Settings.MacroIntervalSeconds, UpdateSourceTrigger=Explicit}"
                                         LostFocus="MacroIntervalTextBox_LostFocus"/>
                                <Slider Value="{Binding Settings.MacroIntervalSeconds}" Minimum="1" Maximum="300"
                                        Width="180" Height="34" Margin="12,0,0,0" VerticalAlignment="Center"
                                        SmallChange="1" LargeChange="10"/>
                            </StackPanel>
                        </Grid>

                        <!-- 操作避让（毫秒）：键鼠空闲后才注入，避免打断游戏操作 -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_MacroIdleLabel}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="MacroIdleTextBox" Width="60" TextAlignment="Center"
                                         Text="{Binding Settings.MacroIdleWaitMs, UpdateSourceTrigger=Explicit}"
                                         LostFocus="MacroIdleTextBox_LostFocus"/>
                                <TextBlock Text="{DynamicResource Settings_MacroIdleHint}" FontSize="12" Foreground="#888"
                                           Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- 重复次数（1-99 或无限循环） -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_MacroRepeatLabel}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="MacroRepeatTextBox" Width="60" TextAlignment="Center"
                                         Text="{Binding Settings.MacroRepeatCount, UpdateSourceTrigger=Explicit}"
                                         LostFocus="MacroRepeatTextBox_LostFocus"/>
                                <CheckBox x:Name="MacroInfiniteCheckBox" Content="{DynamicResource Settings_MacroInfiniteLabel}" FontSize="15"
                                          Margin="16,0,0,0" VerticalAlignment="Center"
                                          Checked="MacroInfiniteCheckBox_Changed" Unchecked="MacroInfiniteCheckBox_Changed"/>
                            </StackPanel>
                        </Grid>

                        <!-- 测试 + 运行状态实时显示 -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_MacroStatusLabel}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{DynamicResource Settings_MacroTestButton}" Command="{Binding MacroTestCommand}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MacroStatusText}" Foreground="{Binding MacroStatusBrush}"
                                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Expander>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
