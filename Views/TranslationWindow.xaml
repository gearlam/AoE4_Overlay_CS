<Window x:Class="AoE4OverlayCS.Views.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Tr_Title}" Width="620" Height="620" MinWidth="440" MinHeight="400"
        Topmost="True" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{DynamicResource Tr_Settings}" Click="Settings_Click" Padding="8,4"/>
            <TextBlock VerticalAlignment="Center"><Run Text="{Binding Settings.SourceLanguage}"/><Run Text=" → "/><Run Text="{Binding Settings.TargetLanguage}"/></TextBlock>
        </DockPanel>
        <TextBox Grid.Row="1" x:Name="InputBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}"
                 TextWrapping="Wrap" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" Margin="0,10" PreviewKeyDown="Input_KeyDown"/>
        <WrapPanel Grid.Row="2">
            <Button Content="{DynamicResource Tr_Translate}" Command="{Binding TranslateCommand}" Padding="12,5" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Tr_Copy}" Command="{Binding CopyCommand}" Padding="12,5"/>
        </WrapPanel>
        <TextBox Grid.Row="3" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="85" VerticalScrollBarVisibility="Auto" Margin="0,10"/>
        <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="5" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="{DynamicResource Tr_Clear}" Command="{Binding ClearCommand}" Padding="8,3"/>
            <Button DockPanel.Dock="Right" Content="{DynamicResource Tr_HistoryFolder}" Command="{Binding OpenHistoryFolderCommand}" Padding="8,3" Margin="0,0,8,0"/>
            <TextBlock Text="{DynamicResource Tr_History}" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox Grid.Row="6" ItemsSource="{Binding History}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Caption}" Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding Original, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"/>
                            <TextBox Text="{Binding Translated, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{DynamicResource Tr_Copy}" Margin="0,0,8,0"
                                        Command="{Binding DataContext.CopyHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,2"/>
                                <Button Content="{DynamicResource Tr_Delete}"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
